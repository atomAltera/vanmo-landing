---
import yaml from 'js-yaml';
import { readFileSync } from 'fs';

const siteData = yaml.load(readFileSync('src/data/site.yaml', 'utf8')) as {
  social: { telegram: string };
};
---

<section class="section-edge section-padding mafia-section">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid gap-16 lg:grid-cols-[1.1fr,0.9fr] items-start">

      <!-- Left -->
      <div>
        <p class="kicker mb-7">Об игре</p>
        <h2 class="font-display mafia-heading text-white mb-7">
          Мафия — это игра<br/>
          <em class="mafia-heading-em">на грани правды и лжи</em>
        </h2>
        <p class="mafia-body">
          Интеллектуальный командный формат: вы тренируете логику, публичную речь и чтение людей.
          В VANMO игра проходит по спортивному регламенту — каждая партия динамична и честна.
        </p>

        <div class="mt-10 flex flex-col sm:flex-row gap-3">
          <a
            href={siteData.social.telegram}
            target="_blank"
            rel="noopener noreferrer"
            class="cta-button btn-primary"
          >
            Записаться на игру
          </a>
          <a href="/rules" class="btn-secondary">Правила игры</a>
        </div>
      </div>

      <!-- Right: three skills -->
      <div class="mafia-skills">
        <div class="skill-item">
          <span class="skill-num font-display">01</span>
          <div>
            <p class="skill-title font-display">Логика</p>
            <p class="skill-desc">Анализ и дедукция</p>
          </div>
        </div>
        <div class="skill-sep"></div>
        <div class="skill-item">
          <span class="skill-num font-display">02</span>
          <div>
            <p class="skill-title font-display">Психология</p>
            <p class="skill-desc">Чтение людей</p>
          </div>
        </div>
        <div class="skill-sep"></div>
        <div class="skill-item">
          <span class="skill-num font-display">03</span>
          <div>
            <p class="skill-title font-display">Интуиция</p>
            <p class="skill-desc">Решения под давлением</p>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  .mafia-section { background: var(--bg); }

  .mafia-heading {
    font-size: clamp(2.25rem, 5vw, 3.75rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.01em;
    color: var(--text);
  }
  .mafia-heading-em {
    font-style: italic;
    color: var(--accent);
  }

  .mafia-body {
    font-size: 1.0625rem;
    font-weight: 300;
    line-height: 1.65;
    color: var(--text-muted);
    max-width: 34rem;
  }

  .mafia-skills {
    border: 1px solid var(--border);
    border-radius: 3px;
    overflow: hidden;
  }

  .skill-item {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding: 1.5rem 1.75rem;
  }

  .skill-sep {
    height: 1px;
    background: var(--border);
    margin: 0 1.75rem;
  }

  .skill-num {
    font-size: 2.5rem;
    font-weight: 600;
    line-height: 1;
    color: var(--accent);
    min-width: 3rem;
    opacity: 0.6;
  }

  .skill-title {
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--text);
    line-height: 1.2;
    margin-bottom: 0.25rem;
  }

  .skill-desc {
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-dim);
  }

  :root.day-mode .mafia-skills {
    background: #fff;
    box-shadow: 0 4px 24px rgba(22, 19, 16, 0.06);
  }
  :root.day-mode .mafia-heading { color: var(--text); }
</style>
