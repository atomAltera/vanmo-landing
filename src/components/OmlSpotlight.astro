---
interface Props {
  /**
   * - `page`    — the card as it appears on the site.
   * - `og`      — 1200×630 social preview. Shown at roughly a third of that,
   *               so it carries less content at far larger sizes rather than
   *               shrinking the page card.
   * - `cover`   — 1096×612 canvas downsampled to a 274×153 thumbnail. Only the
   *               title and the stage label survive at that size.
   */
  variant?: 'page' | 'og' | 'cover';
  /** Stage label for `cover`, e.g. "Серия 1" or "Финал". */
  label?: string;
}

const { variant = 'page', label } = Astro.props;

// Shared between both layouts so a schedule/price change is a single edit.
const dates = '30 августа — 25 октября 2026';
const prizePool = '450 EUR';
const entryFee = '110 GEL';
const seriesCount = '5 + финал';
const prizes = ['200 EUR', '150 EUR', '100 EUR'];
---

<div class:list={['oml-spotlight', variant !== 'page' && `oml-spotlight--${variant}`]}>
  <div class="oml-spotlight__glow" aria-hidden="true"></div>
  <div class="oml-spotlight__noise" aria-hidden="true"></div>
  <div class="oml-spotlight__watermark font-display" aria-hidden="true">2026</div>

  {variant !== 'page' ? (
    <div class="oml-og">
      <div class="oml-og__left">
        <h3 class="oml-og__title font-display">One More<br>League<br><em class="oml-og__year">2026</em></h3>

        <p class="oml-og__dates">{variant === 'cover' ? label : dates}</p>
      </div>

      {variant === 'og' && (
        <div class="oml-og__right">
          <p class="oml-og__pool-label">Призовой фонд</p>
          <p class="oml-og__pool">{prizePool}</p>

          <div class="oml-og__prizes">
            {prizes.map((amount, i) => (
              <div class="oml-og__prize">
                <span class="oml-og__numeral font-display">{'I'.repeat(i + 1)}</span>
                <span class="oml-og__amount">{amount}</span>
              </div>
            ))}
          </div>
        </div>
      )}
    </div>
  ) : (
    <div class="oml-spotlight__inner">
      <!-- LEFT: content -->
      <div class="oml-spotlight__left">
        <div class="oml-spotlight__tags">
          <span class="oml-tag oml-tag--type">Турнир</span>
          <span class="oml-tag oml-tag--level">iMafia Bronze</span>
          <span class="oml-tag oml-tag--live">
            <span class="oml-tag__dot"></span>Серия 1 · регистрация открыта
          </span>
        </div>

        <h3 class="oml-spotlight__title font-display">One More League<br><em class="oml-title-year">2026</em></h3>
        <p class="oml-spotlight__subtitle">Тематический серийный турнир по мафии в Тбилиси</p>

        <div class="oml-spotlight__stats">
          <div class="oml-stat">
            <span class="oml-stat__value">{prizePool}</span>
            <span class="oml-stat__label">призовой фонд</span>
          </div>
          <div class="oml-stat-sep" aria-hidden="true">◆</div>
          <div class="oml-stat">
            <span class="oml-stat__value">{entryFee}</span>
            <span class="oml-stat__label">вход в серию</span>
          </div>
          <div class="oml-stat-sep" aria-hidden="true">◆</div>
          <div class="oml-stat">
            <span class="oml-stat__value">{seriesCount}</span>
            <span class="oml-stat__label">серий</span>
          </div>
        </div>

        <p class="oml-spotlight__dates">{dates}</p>

        <div class="oml-spotlight__cta">
          <a
            href="https://imafia.org/tournament/1755"
            class="btn-primary"
            target="_blank"
            rel="noopener noreferrer"
          >
            Зарегистрироваться на Серию 1
          </a>
          <a href="/events/one_more_league_2026" class="btn-secondary">
            Подробнее
          </a>
        </div>
      </div>

      <!-- RIGHT: prizes -->
      <div class="oml-spotlight__right" aria-hidden="true">
        <p class="oml-prizes__kicker">Призовые места</p>
        <div class="oml-prizes">
          {prizes.map((amount, i) => (
            <div class="oml-prize">
              <span class="oml-prize__numeral font-display">{'I'.repeat(i + 1)}</span>
              <span class="oml-prize__dots"></span>
              <span class="oml-prize__amount">{amount}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  )}
</div>

<style>
  /* ── SPOTLIGHT CARD ── */
  .oml-spotlight {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--border);
    border-top: 2px solid var(--gold-dim);
    background: var(--bg-raised);
    background-image: url('/images/events/oml2026-bg-dark.jpg');
    background-size: cover;
    background-position: center;
  }

  .oml-spotlight::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      105deg,
      rgba(10, 8, 6, 0.82) 0%,
      rgba(10, 8, 6, 0.72) 45%,
      rgba(10, 8, 6, 0.55) 100%
    );
    pointer-events: none;
    z-index: 0;
  }

  /* ── LIGHT / DAY MODE ── */
  :global(:root.day-mode) .oml-spotlight {
    background-image: url('/images/events/oml2026-bg-light.jpg');
  }

  :global(:root.day-mode) .oml-spotlight::after {
    background: linear-gradient(
      105deg,
      rgba(240, 232, 210, 0.82) 0%,
      rgba(240, 232, 210, 0.68) 45%,
      rgba(240, 232, 210, 0.45) 100%
    );
  }

  :global(:root.day-mode) .oml-spotlight__inner {
    --text: #1c1510;
    --text-muted: rgba(28, 21, 16, 0.72);
    --text-dim: rgba(28, 21, 16, 0.5);
    --border: rgba(28, 21, 16, 0.18);
    --gold: #7a5c0f;
    --gold-dim: rgba(122, 92, 15, 0.45);
    color: #1c1510;
  }

  .oml-spotlight__glow {
    position: absolute;
    top: -60px;
    left: -60px;
    width: 420px;
    height: 420px;
    background: radial-gradient(circle, rgba(200, 169, 106, 0.12) 0%, transparent 70%);
    pointer-events: none;
    z-index: 1;
  }

  .oml-spotlight__noise {
    position: absolute;
    inset: 0;
    opacity: 0.03;
    pointer-events: none;
    z-index: 1;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
    background-size: 256px 256px;
  }

  .oml-spotlight__watermark {
    position: absolute;
    z-index: 1;
    right: -0.05em;
    bottom: -0.25em;
    font-size: clamp(7rem, 18vw, 14rem);
    font-weight: 300;
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1px rgba(200, 169, 106, 0.08);
    user-select: none;
    pointer-events: none;
    letter-spacing: -0.02em;
  }

  .oml-spotlight__inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 3rem;
    padding: 2.75rem 3rem;
    align-items: start;
    /* force light text regardless of theme */
    --text: #f0ece4;
    --text-muted: rgba(240, 236, 228, 0.7);
    --text-dim: rgba(240, 236, 228, 0.45);
    --border: rgba(240, 236, 228, 0.15);
    --gold: #c8a96a;
    --gold-dim: rgba(200, 169, 106, 0.4);
    color: #f0ece4;
  }

  /* ── TAGS ── */
  .oml-spotlight__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }

  .oml-tag {
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    padding: calc(0.2rem + 1px) 0.65rem calc(0.2rem - 1px);
    border-radius: 2px;
  }

  .oml-tag--type {
    background: var(--accent);
    color: #fff;
  }

  .oml-tag--level {
    border: 1px solid var(--gold-dim);
    color: var(--gold);
    background: transparent;
  }

  .oml-tag--live {
    border: 1px solid var(--border);
    color: var(--text-muted);
    background: transparent;
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .oml-tag__dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #4ade80;
    flex-shrink: 0;
    animation: pulse-dot 2s ease-in-out infinite;
  }

  @keyframes pulse-dot {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }

  /* ── TITLE ── */
  .oml-spotlight__title {
    font-size: clamp(2rem, 4.5vw, 3.5rem);
    font-weight: 300;
    line-height: 0.9;
    color: var(--text);
    margin-bottom: 0.6rem;
    max-width: 18ch;
  }

  .oml-title-year {
    font-style: italic;
    color: var(--accent);
  }

  .oml-spotlight__subtitle {
    font-size: 0.9375rem;
    color: var(--text-muted);
    font-weight: 300;
    margin-bottom: 2rem;
    max-width: 44ch;
  }

  /* ── STATS ── */
  .oml-spotlight__stats {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-wrap: wrap;
    padding: 1.25rem 0;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    margin-bottom: 1rem;
  }

  .oml-stat {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .oml-stat__value {
    font-size: 1.0625rem;
    font-weight: 500;
    color: var(--text);
  }

  .oml-stat__label {
    font-size: 0.625rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--text-dim);
  }

  .oml-stat-sep {
    color: var(--gold-dim);
    font-size: 0.4375rem;
  }

  /* ── DATES ── */
  .oml-spotlight__dates {
    font-size: 0.8125rem;
    letter-spacing: 0.1em;
    color: var(--text-dim);
    text-transform: uppercase;
    margin: 0.75rem 0 1.75rem;
  }

  /* ── CTA ── */
  .oml-spotlight__cta {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  /* ── PRIZES (right column) ── */
  .oml-spotlight__right {
    min-width: 220px;
    padding: 1.5rem;
    margin: -1.25rem 0 -1.5rem 0;
    border-left: 1px solid var(--border);
    border-radius: 4px;
    background: rgba(8, 6, 4, 0.28);
    backdrop-filter: blur(4px);
  }

  :global(:root.day-mode) .oml-spotlight__right {
    background: rgba(240, 232, 210, 0.45);
  }

  .oml-prizes__kicker {
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 1.25rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .oml-prizes__kicker::after {
    content: '';
    display: block;
    width: 1.5rem;
    height: 1px;
    background: var(--gold-dim);
  }

  .oml-prizes {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .oml-prize {
    display: flex;
    align-items: baseline;
    gap: 0;
    padding: 0.875rem 0;
    border-bottom: 1px solid var(--border);
  }
  .oml-prize:first-child { border-top: 1px solid var(--border); }

  .oml-prize__numeral {
    font-size: 1.5rem;
    font-weight: 300;
    color: var(--gold);
    min-width: 2.5rem;
    line-height: 1;
  }
  .oml-prize:nth-child(2) .oml-prize__numeral { color: var(--text-muted); }
  .oml-prize:nth-child(3) .oml-prize__numeral { color: var(--text-dim); }

  .oml-prize__dots {
    flex: 1;
    border-bottom: 1px dotted var(--border);
    margin: 0 0.75rem 0.2rem;
  }

  .oml-prize__amount {
    font-size: 1rem;
    font-weight: 500;
    color: var(--text);
    white-space: nowrap;
  }

  /* ── RESPONSIVE ── */
  @media (max-width: 768px) {
    .oml-spotlight__inner {
      grid-template-columns: 1fr;
      padding: 2rem 1.75rem;
      gap: 2rem;
    }

    .oml-spotlight__right {
      border-left: none;
      border-top: 1px solid var(--border);
      padding-top: 2rem;
    }

    .oml-spotlight__watermark {
      font-size: 30vw;
    }
  }

  /* ── OG SNAPSHOT VARIANT (1200×630) ──
     A link preview renders at roughly a third of this size, so every value
     below is chosen to survive that: nothing smaller than ~24px, and labels
     folded into the text they describe instead of set as tiny captions. */
  .oml-spotlight--og {
    width: 1200px;
    height: 630px;
    border: none;
    border-top: 5px solid var(--gold-dim);
  }

  .oml-og {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr 25rem;
    height: 100%;
    /* force the dark palette regardless of the snapshot browser's theme */
    --text: #f0ece4;
    --text-muted: rgba(240, 236, 228, 0.72);
    --text-dim: rgba(240, 236, 228, 0.5);
    --border: rgba(240, 236, 228, 0.16);
    --gold: #d8b877;
    --gold-dim: rgba(200, 169, 106, 0.4);
    color: var(--text);
  }

  .oml-og__left {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 2rem 2.5rem;
    min-width: 0;
  }

  .oml-og__right {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 2rem 2.25rem 2rem 2.5rem;
    border-left: 1px solid var(--border);
    background: rgba(8, 6, 4, 0.5);
    backdrop-filter: blur(3px);
  }

  /* ── LEFT ── */
  .oml-og__title {
    font-size: 10rem;
    font-weight: 600;
    line-height: 0.86;
    color: var(--text);
    white-space: nowrap;
    margin-bottom: 2.5rem;
  }

  .oml-og__year {
    font-style: italic;
    color: var(--accent);
  }

  .oml-og__dates {
    font-size: 3rem;
    font-weight: 500;
    line-height: 1.15;
    color: var(--gold);
  }

  /* ── RIGHT ── */
  .oml-og__pool-label {
    font-size: 1.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 0.5rem;
  }

  /* sans, not the display serif: Cormorant's old-style figures turn "450" into "45o" */
  .oml-og__pool {
    font-size: 4.75rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1;
    color: var(--text);
    margin-bottom: 2.25rem;
  }

  .oml-og__prizes {
    display: flex;
    flex-direction: column;
  }

  .oml-og__prize {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.6rem 0;
    border-top: 1px solid var(--border);
  }
  .oml-og__prize:last-child {
    border-bottom: 1px solid var(--border);
  }

  .oml-og__numeral {
    font-size: 3.25rem;
    font-weight: 600;
    line-height: 1;
    color: var(--gold);
  }
  .oml-og__prize:nth-child(2) .oml-og__numeral { color: var(--text-muted); }
  .oml-og__prize:nth-child(3) .oml-og__numeral { color: var(--text-dim); }

  .oml-og__amount {
    font-size: 2.75rem;
    font-weight: 600;
    color: var(--text);
    white-space: nowrap;
  }

  .oml-spotlight--og .oml-spotlight__watermark {
    font-size: 20rem;
    bottom: -0.3em;
    right: 24rem;
  }

  /* ── COVER VARIANT (1096×612, shipped as a 274×153 thumbnail) ──
     Downsampled 4×, so only the title and the stage label are left. */
  .oml-spotlight--cover {
    width: 1096px;
    height: 612px;
    border: none;
    border-top: 5px solid var(--gold-dim);
  }

  /* no prize panel over the artwork here, so the scrim can lift a lot and let
     the train read — it stays heavy on the left, under the title */
  .oml-spotlight--cover::after {
    background: linear-gradient(
      105deg,
      rgba(10, 8, 6, 0.78) 0%,
      rgba(10, 8, 6, 0.5) 42%,
      rgba(10, 8, 6, 0.14) 100%
    );
  }

  .oml-spotlight--cover .oml-og {
    grid-template-columns: 1fr;
  }

  .oml-spotlight--cover .oml-og__left {
    padding: 3.5rem;
  }

  .oml-spotlight--cover .oml-og__title {
    font-size: 8.75rem;
    margin-bottom: 2.75rem;
  }

  .oml-spotlight--cover .oml-og__dates {
    font-size: 4.5rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .oml-spotlight--cover .oml-spotlight__watermark {
    font-size: 22rem;
    bottom: -0.3em;
    right: 1rem;
  }
</style>
