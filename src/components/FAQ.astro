---
const faqData = [
  {
    question: "Что такое спортивная мафия?",
    answer: 'Спортивная мафия — это командная психологическая игра с чёткими правилами и судейством. В отличие от обычной мафии, здесь важны логика, аргументация и умение читать людей.'
  },
  {
    question: "Нужен ли опыт игры?",
    answer: 'Нет, мы рады как опытным игрокам, так и новичкам. Перед первой игрой мы объясним все правила и поможем освоиться.'
  },
  {
    question: "Как часто проходят игры?",
    answer: 'Каждую субботу и понедельник, следите за анонсами в нашем <a href="https://t.me/vanmo_mafia" class="faq-link">Telegram-канале</a>.'
  },
  {
    question: "Сколько стоит участие?",
    answer: 'Игра стоит 20 GEL за вечер. Посмотреть игру можно бесплатно.'
  },
  {
    question: "Сколько длится игровой вечер?",
    answer: 'Обычно 2.5–4 часа в зависимости от количества столов и партий.'
  },
  {
    question: "На каком языке проходит игра?",
    answer: 'Основной язык игр в клубе — русский.'
  },
  {
    question: "Что делать, если я ни разу не играл(а)?",
    answer: 'Просто приходите на ближайший игровой день: перед стартом мы объясним базовые правила и формат выступлений.'
  },
  {
    question: "Во сколько лучше приходить?",
    answer: 'Лучше приходить заранее, чтобы спокойно зарегистрироваться и познакомиться с форматом до первой партии.'
  },
  {
    question: "Есть ли возрастные ограничения?",
    answer: 'К участию допускаются гости 18+.'
  }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqData.map(item => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer.replace(/<[^>]*>/g, '')
    }
  }))
};
---

<section class="section-edge section-padding faq-section">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="faq-layout">

      <!-- Header -->
      <div class="faq-header">
        <p class="kicker mb-7">FAQ</p>
        <h2 class="font-display faq-heading">
          Частые<br/><em>вопросы</em>
        </h2>
        <p class="faq-subheading">
          Короткие ответы для тех, кто планирует первую игру.
        </p>
      </div>

      <!-- List -->
      <dl class="faq-list">
        {faqData.map((item, index) => (
          <div class="faq-row">
            <div class="faq-row-inner">
              <span class="faq-num font-display">{(index + 1).toString().padStart(2, '0')}</span>
              <div class="faq-text">
                <dt class="faq-q">{item.question}</dt>
                <dd class="faq-a" set:html={item.answer} />
              </div>
            </div>
          </div>
        ))}
      </dl>

    </div>
  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

<style>
  .faq-section { background: var(--bg); }

  .faq-layout {
    display: grid;
    gap: 4rem;
  }

  @media (min-width: 1024px) {
    .faq-layout {
      grid-template-columns: 0.4fr 0.6fr;
      gap: 5rem;
      align-items: start;
    }
  }

  .faq-heading {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 700;
    line-height: 0.9;
    letter-spacing: -0.02em;
    color: var(--text);
    margin-bottom: 1.5rem;
  }
  .faq-heading em {
    font-style: italic;
    color: var(--gold);
  }

  .faq-subheading {
    font-size: 0.9375rem;
    font-weight: 300;
    line-height: 1.6;
    color: var(--text-muted);
  }

  .faq-list {
    display: flex;
    flex-direction: column;
  }

  .faq-row {
    border-top: 1px solid var(--border);
    padding: 1.5rem 0;
  }
  .faq-row:last-child { border-bottom: 1px solid var(--border); }

  .faq-row-inner {
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: 1rem;
    align-items: start;
  }

  .faq-num {
    font-size: 1.75rem;
    font-weight: 600;
    line-height: 1;
    color: var(--border-md);
    padding-top: 0.1rem;
  }

  .faq-q {
    font-size: 1rem;
    font-weight: 500;
    color: var(--text);
    line-height: 1.45;
    margin-bottom: 0.6rem;
  }

  .faq-a {
    font-size: 0.9375rem;
    font-weight: 300;
    line-height: 1.65;
    color: var(--text-muted);
  }

  :global(.faq-link) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  :global(.faq-link:hover) { opacity: 0.8; }

  :root.day-mode .faq-section { background: var(--bg); }
  :root.day-mode .faq-heading { color: var(--text); }
  :root.day-mode .faq-num { color: var(--border-md); }
</style>
