---
import eventsData from '../data/events.json';

const events = eventsData;

function typeLabel(type: string) {
  return type === 'tournament' ? 'Турнир' : 'Событие';
}
---

<section id="events" class="section-padding section-edge">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-6xl">
    <div class="mb-10 md:mb-14">
      <p class="kicker">События</p>
      <h2 class="font-display text-[clamp(2.25rem,5vw,3.75rem)] font-light leading-tight mt-3">
        Предстоящие турниры
      </h2>
    </div>

    <div class="events-grid">
      {events.map((event) => (
        <article class="event-card glass-card">
          <a href={`/events/${event.slug}`} class="event-card__image-wrap" aria-label={`Подробнее: ${event.title}`}>
            <img
              src={event.image}
              alt={event.title}
              width="500"
              height="334"
              class="event-card__image"
              loading="lazy"
            />
            <span class="event-card__badge">{typeLabel(event.type)}</span>
          </a>
          <div class="event-card__body">
            <p class="event-card__dates">{event.cardDateRange}</p>
            <h3 class="event-card__title font-display">{event.title}</h3>
            <p class="event-card__subtitle">{event.subtitle}</p>
            <div class="event-card__footer">
              <a href={`/events/${event.slug}`} class="btn-secondary event-card__btn">
                Подробнее →
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .events-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.5rem;
  }

  .event-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: 4px;
    transition: border-color 0.2s;
  }

  .event-card:hover {
    border-color: var(--gold-dim);
  }

  .event-card__image-wrap {
    position: relative;
    flex-shrink: 0;
    display: block;
  }

  .event-card__image-wrap:hover .event-card__image {
    opacity: 0.9;
  }

  .event-card__image {
    width: 100%;
    aspect-ratio: 500 / 334;
    object-fit: cover;
    display: block;
    transition: opacity 0.2s;
  }

  .event-card__badge {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    background: var(--accent);
    color: #fff;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    padding: 0.2rem 0.6rem;
    border-radius: 2px;
  }

  .event-card__body {
    padding: 1.25rem 1.5rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    flex: 1;
  }

  .event-card__dates {
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .event-card__title {
    font-size: 1.5rem;
    font-weight: 400;
    line-height: 1.2;
    color: var(--text);
  }

  .event-card__subtitle {
    font-size: 0.9375rem;
    color: var(--text-muted);
    line-height: 1.5;
  }

  .event-card__footer {
    margin-top: auto;
    padding-top: 1rem;
  }

  .event-card__btn {
    font-size: 0.875rem;
  }
</style>
