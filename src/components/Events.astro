---
---

<section id="events" class="section-padding section-edge">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-6xl">
    <div class="mb-10 md:mb-14">
      <p class="kicker">События</p>
      <h2 class="font-display text-[clamp(2.25rem,5vw,3.75rem)] font-light leading-tight mt-3">
        Предстоящие турниры
      </h2>
    </div>

    <div class="events-grid">
      <a href="/events/one_more_league_2026" class="event-card glass-card" aria-label="One More League 2026">
        <img
          src="/images/events/oml2026-cover.jpg"
          alt="One More League 2026"
          width="500"
          height="334"
          class="event-card__image"
          loading="lazy"
        />
        <span class="event-card__badge">Турнир</span>
      </a>
    </div>
  </div>
</section>

<style>
  .events-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.5rem;
  }

  .event-card {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: 4px;
    transition: border-color 0.2s, opacity 0.2s;
  }

  .event-card:hover {
    border-color: var(--gold-dim);
    opacity: 0.9;
  }

  .event-card__image {
    width: 100%;
    aspect-ratio: 500 / 334;
    object-fit: cover;
    display: block;
  }

  .event-card__badge {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    background: var(--accent);
    color: #fff;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    padding: 0.2rem 0.6rem;
    border-radius: 2px;
  }
</style>
