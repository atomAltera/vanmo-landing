---
import OmlSpotlight from './OmlSpotlight.astro';
---

<section id="events" class="section-padding section-edge">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-6xl">
    <div class="events-header">
      <p class="kicker">События</p>
      <h2 class="font-display text-[clamp(2.25rem,5vw,3.75rem)] font-light leading-tight mt-3">
        Предстоящие турниры
      </h2>
    </div>

    <OmlSpotlight />
  </div>
</section>

<style>
  .events-header {
    margin-bottom: 2.5rem;
  }
</style>
