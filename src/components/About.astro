---
---

<section class="section-edge section-padding about-section">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="grid gap-16 lg:grid-cols-[1fr,1fr] items-start">

      <!-- Left -->
      <div>
        <p class="kicker mb-7">О клубе</p>
        <h2 class="font-display about-heading">
          Место, где сходятся<br/>
          <em class="about-heading-em">стратегия и интуиция</em>
        </h2>
        <p class="about-body">
          VANMO — клуб для любителей классической спортивной мафии в Тбилиси.
          Живое комьюнити, уважительный формат, сильная игра и комфортный старт для новых участников.
        </p>
      </div>

      <!-- Right: feature cards -->
      <div class="about-features">

        <div class="about-item">
          <div class="about-item-icon">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.182 15.182a4.5 4.5 0 01-6.364 0M21 12a9 9 0 11-18 0 9 9 0 0118 0zM9.75 9.75c0 .414-.168.75-.375.75S9 10.164 9 9.75 9.168 9 9.375 9s.375.336.375.75zm-.375 0h.008v.015h-.008V9.75zm5.625 0c0 .414-.168.75-.375.75s-.375-.336-.375-.75.168-.75.375-.75.375.336.375.75zm-.375 0h.008v.015h-.008V9.75z" />
            </svg>
          </div>
          <div>
            <p class="about-item-title font-display">Дружелюбный вход</p>
            <p class="about-item-desc">Понятно даже с нуля</p>
          </div>
        </div>

        <div class="about-sep"></div>

        <div class="about-item">
          <div class="about-item-icon">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 21v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21m0 0h4.5V3.545M12.75 21h7.5V10.75M2.25 21h1.5m18 0h-18M2.25 9l4.5-1.636M18.75 3l-1.5.545m0 6.205l3 1m1.5.5l-1.5-.5M6.75 7.364V3h-3v18m3-13.636l10.5-3.819" />
            </svg>
          </div>
          <div>
            <p class="about-item-title font-display">Стабильное расписание</p>
            <p class="about-item-desc">Понедельники и субботы</p>
          </div>
        </div>

        <div class="about-sep"></div>

        <div class="about-item">
          <div class="about-item-icon">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 8.25v-1.5m0 1.5c-1.355 0-2.697.056-4.024.166C6.845 8.51 6 9.473 6 10.608v2.513m6-4.87c1.355 0 2.697.055 4.024.165C17.155 8.51 18 9.473 18 10.608v2.513m-3-4.87v-1.5m-6 1.5v-1.5m12 9.75l-1.5.75a3.354 3.354 0 01-3 0 3.354 3.354 0 00-3 0 3.354 3.354 0 01-3 0 3.354 3.354 0 00-3 0 3.354 3.354 0 01-3 0L3 16.5m15-3.38a48.474 48.474 0 00-6-.37c-2.032 0-4.034.125-6 .37m12 0c.39.049.777.102 1.163.16 1.07.16 1.837 1.094 1.837 2.175v5.17c0 .62-.504 1.124-1.125 1.124H4.125A1.125 1.125 0 013 20.625v-5.17c0-1.08.768-2.014 1.837-2.174A47.78 47.78 0 016 13.12M12.265 3.11a.375.375 0 11-.53 0L12 2.845l.265.265zm-3 0a.375.375 0 11-.53 0L9 2.845l.265.265zm6 0a.375.375 0 11-.53 0L15 2.845l.265.265z" />
            </svg>
          </div>
          <div>
            <p class="about-item-title font-display">Спортивный стандарт</p>
            <p class="about-item-desc">Официальный клуб FIIM и iMafia</p>
          </div>
        </div>

      </div>
    </div>
  </div>
</section>

<style>
  .about-section { background: var(--bg-raised); }

  .about-heading {
    font-size: clamp(2.25rem, 5vw, 3.75rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.01em;
    color: var(--text);
    margin-bottom: 1.75rem;
  }
  .about-heading-em {
    font-style: italic;
    color: var(--gold);
  }

  .about-body {
    font-size: 1.0625rem;
    font-weight: 300;
    line-height: 1.65;
    color: var(--text-muted);
    max-width: 32rem;
  }

  .about-features {
    border: 1px solid var(--border);
    border-radius: 3px;
    overflow: hidden;
  }

  .about-item {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding: 1.5rem 1.75rem;
  }

  .about-sep {
    height: 1px;
    background: var(--border);
    margin: 0 1.75rem;
  }

  .about-item-icon {
    width: 2.5rem;
    height: 2.5rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: var(--gold);
    border: 1px solid var(--gold-dim);
    border-radius: 3px;
  }

  .about-item-title {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--text);
    line-height: 1.3;
    margin-bottom: 0.2rem;
  }

  .about-item-desc {
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  :root.day-mode .about-section { background: #f5f0e8; }
  :root.day-mode .about-features {
    background: #fff;
    box-shadow: 0 4px 24px rgba(22, 19, 16, 0.06);
  }
  :root.day-mode .about-heading { color: var(--text); }
</style>
