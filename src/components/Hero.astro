---
import yaml from 'js-yaml';
import { readFileSync } from 'fs';

const siteData = yaml.load(readFileSync('src/data/site.yaml', 'utf8')) as {
  social: {
    telegram: string;
  };
};
---

<section class="hero-section section-edge">
  <div class="hero-inner max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Left: Main content -->
    <div class="hero-content">
      <h1 class="hero-title font-display">
        Клуб<br/>
        спортивной<br/>
        <em class="hero-title-em">мафии</em>
      </h1>

      <p class="hero-location">в Тбилиси</p>

      <p class="hero-subtitle">
        Регулярные игры по понедельникам и субботам.<br class="hidden sm:block"/>
        Приходите знакомиться и играть вместе.
      </p>

      <div class="hero-ctas">
        <a
          href={siteData.social.telegram}
          target="_blank"
          rel="noopener noreferrer"
          class="cta-button btn-primary focus:outline-none focus:ring-2 focus:ring-red-700 focus:ring-offset-2 focus:ring-offset-black"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/>
          </svg>
          Записаться на ближайшую игру
        </a>
        <a href="/rules" class="btn-secondary">Как проходит игра</a>
      </div>

      <p class="hero-proof">
        Официальный клуб
        <a
          href="https://mafiaworldtour.org/clubs/349"
          target="_blank"
          rel="noopener noreferrer"
          class="hero-proof-link"
        >FIIM</a>
        {' и '}
        <a
          href="https://imafia.org/club/101"
          target="_blank"
          rel="noopener noreferrer"
          class="hero-proof-link"
        >iMafia</a>
      </p>
    </div>

    <!-- Right: Steps panel -->
    <div class="hero-steps">
      <p class="steps-label">4 шага до первой игры</p>
      <ol class="steps-list">
        <li class="step-item">
          <span class="step-num font-display">01</span>
          <span class="step-text">Вступить в Telegram-группу</span>
        </li>
        <li class="step-item">
          <span class="step-num font-display">02</span>
          <span class="step-text">Выбрать ближайший анонс</span>
        </li>
        <li class="step-item">
          <span class="step-num font-display">03</span>
          <span class="step-text">Отметиться в опросе</span>
        </li>
        <li class="step-item">
          <span class="step-num font-display">04</span>
          <span class="step-text">Прийти и играть</span>
        </li>
      </ol>
      <p class="steps-note">
        Если вы играете впервые — организатор коротко объяснит формат перед началом.
      </p>
    </div>

  </div>
</section>

<style>
  .hero-section {
    position: relative;
    background-color: var(--bg);
    background-image: url('/images/hero-bg-dark.jpg');
    background-size: cover;
    background-position: center right;
    min-height: unset;
    display: flex;
    align-items: center;
    padding: 6rem 0 4rem;
    overflow: hidden;
  }

  .hero-section::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      105deg,
      rgba(10, 8, 6, 0.92) 0%,
      rgba(10, 8, 6, 0.8) 45%,
      rgba(10, 8, 6, 0.55) 100%
    );
    pointer-events: none;
    z-index: 0;
  }

  .hero-inner {
    position: relative;
    z-index: 1;
  }

  /* Hero stays dark in both themes — force light text regardless of theme */
  .hero-section {
    --text: #f0ece4;
    --text-muted: rgba(240, 236, 228, 0.72);
    --text-dim: rgba(240, 236, 228, 0.45);
    --border: rgba(240, 236, 228, 0.15);
    color: #f0ece4;
  }

  .hero-inner {
    width: 100%;
    display: grid;
    gap: 4rem;
    align-items: center;
  }

  @media (min-width: 1024px) {
    .hero-inner {
      grid-template-columns: 1.25fr 0.75fr;
      gap: 5rem;
    }
  }

  /* Kicker */
  .hero-kicker {
    margin-bottom: 2rem;
  }

  /* Headline */
  .hero-title {
    font-size: clamp(3.75rem, 7vw, 6rem);
    font-weight: 700;
    line-height: 0.88;
    letter-spacing: -0.02em;
    color: var(--text);
    margin-bottom: 0.5rem;
  }

  .hero-title-em {
    font-style: italic;
    color: var(--accent);
  }

  .hero-location {
    font-family: var(--font-display);
    font-size: clamp(1.125rem, 2.5vw, 1.625rem);
    font-weight: 400;
    font-style: italic;
    color: var(--text-muted);
    margin-bottom: 2.25rem;
    letter-spacing: 0.01em;
  }

  .hero-subtitle {
    font-size: 1.0625rem;
    font-weight: 300;
    line-height: 1.65;
    color: var(--text-muted);
    max-width: 32rem;
    margin-bottom: 2.75rem;
  }

  .hero-ctas {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    margin-bottom: 2rem;
  }

  @media (min-width: 480px) {
    .hero-ctas {
      flex-direction: row;
      align-items: center;
      flex-wrap: wrap;
    }
  }

  .hero-proof {
    font-size: 0.8125rem;
    color: var(--text-dim);
    letter-spacing: 0.01em;
  }

  .hero-proof-link {
    color: var(--text-muted);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 0.2s ease;
  }

  .hero-proof-link:hover {
    color: var(--text);
  }

  /* Steps panel */
  .hero-steps {
    background: rgba(20, 16, 13, 0.55);
    border: 1px solid var(--border);
    border-radius: 3px;
    padding: 2rem 2rem 1.75rem;
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }

  .steps-label {
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--text-dim);
    margin-bottom: 1.75rem;
  }

  .steps-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1.125rem;
    margin-bottom: 1.75rem;
    border-bottom: 1px solid var(--border);
    padding-bottom: 1.75rem;
  }

  .step-item {
    display: flex;
    align-items: baseline;
    gap: 1rem;
  }

  .step-num {
    font-size: 1.625rem;
    font-weight: 600;
    line-height: 1;
    color: var(--accent);
    min-width: 2.5rem;
    flex-shrink: 0;
  }

  .step-text {
    font-size: 0.9375rem;
    font-weight: 300;
    color: var(--text);
    line-height: 1.4;
  }

  .steps-note {
    font-size: 0.8125rem;
    font-weight: 300;
    line-height: 1.55;
    color: var(--text-muted);
  }

</style>
