---
import BaseLayout from '../../layouts/BaseLayout.astro';
import eventsData from '../../data/events.json';

export function getStaticPaths() {
  return eventsData.map((event) => ({
    params: { slug: event.slug },
    props: { event },
  }));
}

interface Round {
  id: string;
  type: 'qualifier' | 'final';
  number: number | null;
  title: string;
  theme: string | null;
  themeKnown: boolean;
  dateLabel: string | null;
  players: number;
  games: number;
  days: number;
  advance: number | null;
  registration: 'available' | 'past' | 'not-available';
  registrationUrl: string | null;
}

interface Event {
  slug: string;
  type: string;
  title: string;
  subtitle: string;
  cardDateRange: string;
  status: string;
  seriesStart: string;
  seriesEnd: string;
  finalDates: string;
  image: string;
  entryFee: string;
  prizePool: string;
  level: string;
  prizes: { place: number; amount: string; label: string }[];
  youtubeChannel: string;
  languages: string;
  rounds: Round[];
}

const { event } = Astro.props as { event: Event };

const activeRound = event.rounds.find(r => r.registration === 'available') ?? null;
const qualifierCount = event.rounds.filter(r => r.type === 'qualifier').length;
const finalRound = event.rounds.find(r => r.type === 'final')!;
const firstQualifier = event.rounds.find(r => r.type === 'qualifier')!;

const ogImage = new URL(event.image, Astro.site).toString();

function roundAccent(round: Round): string {
  if (round.type === 'final') return 'var(--accent)';
  if (round.themeKnown) return 'var(--gold)';
  return 'var(--text-dim)';
}

function regLabel(round: Round): string {
  if (round.type === 'qualifier' && round.number !== null) {
    return `Зарегистрироваться на Серию ${round.number}`;
  }
  return 'Зарегистрироваться';
}
---

<BaseLayout
  title={`${event.title} — VANMO`}
  description="Серийный турнир по мафии с детективной тематикой. 5 отборочных серий, 10 финалистов, призовой фонд 450 EUR. Финал 24–25 октября 2026 в Тбилиси."
  ogImage={ogImage}
  ogImageWidth={500}
  ogImageHeight={334}
>
  <!-- HERO -->
  <section class="event-hero">
    <div class="event-hero__noise" aria-hidden="true"></div>
    <div class="event-hero__content container mx-auto px-4 sm:px-6 lg:px-8 max-w-6xl">
      <h1 class="event-hero__title font-display">{event.title}</h1>
      <p class="event-hero__subtitle">{event.subtitle}</p>
      <div class="event-hero__stats">
        <div class="event-hero__stats-left">
          <div class="event-stat">
            <span class="event-stat__value">{event.prizePool}</span>
            <span class="event-stat__label">призовой фонд</span>
          </div>
          <div class="event-stat-divider" aria-hidden="true">◆</div>
          <div class="event-stat">
            <span class="event-stat__value">{event.entryFee}</span>
            <span class="event-stat__label">вход в серию</span>
          </div>
          {activeRound && (
            <>
              <div class="event-stat-divider" aria-hidden="true">◆</div>
              <div class="event-stat">
                <span class="event-stat__value event-stat__value--active">{activeRound.title}</span>
                <span class="event-stat__label">открыта регистрация</span>
              </div>
            </>
          )}
        </div>
        {activeRound && (
          <a
            href={activeRound.registrationUrl}
            class="btn-primary event-cta-btn"
            target="_blank"
            rel="noopener noreferrer"
          >
            {regLabel(activeRound)}
          </a>
        )}
      </div>

      <div class="event-hero__info">
        <div class="event-hero__info-grid">
          <div class="event-hero__info-col">
            <p class="event-kicker">О турнире</p>
            <p class="event-hero__description">
              One More League — серийный турнир по мафии с детективной тематикой.
              Пять отборочных серий определят десятерых финалистов, которые сразятся
              за призовой фонд в двухдневном финале. Все игры транслируются на YouTube.
            </p>
            <p class="event-hero__meta">
              Трансляции: YouTube · {event.youtubeChannel}<br />
              Уровень: iMafia {event.level}<br />
              Язык: {event.languages}
            </p>
          </div>
          <div class="event-hero__info-col">
            <p class="event-kicker">Призовой фонд</p>
            <div class="event-prizes">
              {event.prizes.map((prize) => (
                <div class="event-prize">
                  <span class="event-prize__place font-display">{prize.label}</span>
                  <span class="event-prize__amount">{prize.amount}</span>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- STRUCTURE -->
  <section class="section-padding section-edge event-section">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-6xl">
<p class="event-kicker">Формат турнира</p>
      <h2 class="event-section__heading font-display">Путь к финалу</h2>
      <div class="event-structure">
        <div class="event-structure__box">
          <div class="event-structure__number font-display">{qualifierCount}</div>
          <div class="event-structure__label">отборочных серий</div>
          <div class="event-structure__sub">
            {firstQualifier.players} игроков · {firstQualifier.games} игр · топ‑{firstQualifier.advance} в финал
          </div>
        </div>
        <div class="event-structure__arrow" aria-hidden="true">→</div>
        <div class="event-structure__box event-structure__box--final">
          <div class="event-structure__number font-display">{finalRound.players}</div>
          <div class="event-structure__label">финалистов</div>
          <div class="event-structure__sub">
            {finalRound.games} игр · {finalRound.days} дня · {event.finalDates}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ROUNDS -->
  <section class="section-padding section-edge event-section">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-6xl">
<p class="event-kicker">Расписание</p>
      <h2 class="event-section__heading font-display">Серии и финал</h2>
      <div class="rounds-list">
        {event.rounds.map((round) => (
          <div class="round-row" style={`--round-accent: ${roundAccent(round)}`}>
            <span class="round-row__num font-display">
              {round.type === 'final' ? '◆' : round.number}
            </span>
            <div class="round-row__main">
              <span class="round-row__label">{round.title}</span>
              {round.themeKnown
                ? <em class="round-row__theme font-display">{round.theme}</em>
                : <span class="round-row__theme-unknown">Тематика будет объявлена</span>
              }
            </div>
            <div class={`round-row__date${round.dateLabel ? '' : ' round-row__date--unknown'}`}>
              {round.dateLabel ?? 'Дата будет объявлена'}
            </div>
            <div class="round-row__info">
              {round.players} игроков · {round.games} игр
              {round.advance != null && <> · топ‑{round.advance} в финал</>}
            </div>
            <div class="round-row__cta">
              {round.registration === 'available' && (
                <a
                  href={round.registrationUrl}
                  class="btn-primary round-cta-btn"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Зарегистрироваться
                </a>
              )}
              {round.registration === 'past' && (
                <span class="round-badge round-badge--closed">Завершена</span>
              )}
              {round.registration === 'not-available' && round.type === 'qualifier' && (
                <span class="round-badge round-badge--pending">Регистрация откроется позже</span>
              )}
              {round.registration === 'not-available' && round.type === 'final' && (
                <span class="round-badge round-badge--invite">По итогам серий</span>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* ── HERO ── */
  .event-hero {
    position: relative;
    padding: 8rem 0 6rem;
    overflow: hidden;
    border-bottom: 1px solid var(--border);
  }

  .event-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 80% 60% at 50% 0%, rgba(200, 169, 106, 0.08) 0%, transparent 70%);
    pointer-events: none;
  }

  .event-hero__noise {
    position: absolute;
    inset: 0;
    opacity: 0.035;
    pointer-events: none;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E");
    background-size: 256px 256px;
  }

  .event-hero__content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
  }

  /* ── KICKER ── */
  .event-kicker {
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--gold);
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .event-kicker::after {
    content: '';
    display: block;
    width: 2rem;
    height: 1px;
    background: var(--gold-dim);
  }

  .event-hero__title {
    font-size: clamp(3rem, 7vw, 5.5rem);
    font-weight: 300;
    line-height: 1.05;
    color: var(--text);
    max-width: 18ch;
  }

  .event-hero__subtitle {
    font-size: clamp(0.9375rem, 2vw, 1.125rem);
    color: var(--text-muted);
    font-weight: 300;
    max-width: 40ch;
    margin-top: -0.5rem;
  }

  .event-hero__stats {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
    padding: 1.25rem 0;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    width: 100%;
  }

  .event-hero__stats-left {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .event-stat {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .event-stat__value {
    font-size: 1.125rem;
    font-weight: 500;
    color: var(--text);
  }

  .event-stat__value--active {
    color: var(--gold);
  }

  .event-stat__label {
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .event-stat-divider {
    color: var(--gold-dim);
    font-size: 0.5rem;
  }

  .event-cta-btn {
    font-size: 0.9375rem;
    white-space: nowrap;
  }

  /* ── HERO INFO (о турнире + призы, встроены в герой) ── */
  .event-hero__info {
    width: 100%;
    padding-top: 2.5rem;
    margin-top: 0.5rem;
  }

  .event-hero__info-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
  }

  .event-hero__description {
    color: var(--text-muted);
    line-height: 1.7;
    font-size: 1rem;
    margin: 0.75rem 0 1rem;
  }

  .event-hero__meta {
    font-size: 0.875rem;
    color: var(--text-dim);
    line-height: 1.8;
  }

  /* ── SECTIONS ── */
  .event-section {
    background: var(--bg);
  }

  .event-deco-divider {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 2rem;
    color: var(--gold-dim);
    font-size: 0.5rem;
    letter-spacing: 0.5em;
  }

  .event-deco-divider::before,
  .event-deco-divider::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--border);
  }

  .event-section__heading {
    font-size: clamp(1.75rem, 4vw, 3rem);
    font-weight: 300;
    color: var(--text);
    margin: 0.5rem 0 2.5rem;
  }

  /* ── STRUCTURE ── */
  .event-structure {
    display: flex;
    align-items: center;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .event-structure__box {
    flex: 1;
    min-width: 200px;
    padding: 2rem;
    border: 1px solid var(--border);
    border-top-color: var(--gold-dim);
    background: var(--bg-raised);
  }

  .event-structure__number {
    font-size: 4rem;
    font-weight: 300;
    color: var(--gold);
    line-height: 1;
  }

  .event-structure__label {
    font-size: 1rem;
    font-weight: 500;
    color: var(--text);
    margin: 0.25rem 0;
  }

  .event-structure__sub {
    font-size: 0.875rem;
    color: var(--text-muted);
    line-height: 1.5;
  }

  .event-structure__arrow {
    font-size: 1.5rem;
    color: var(--gold-dim);
    flex-shrink: 0;
  }

  /* ── ROUNDS GRID ── */
  .rounds-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1rem;
  }

  /* ── ROUNDS LIST ── */
  .rounds-list {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--border);
  }

  .round-row {
    display: grid;
    grid-template-columns: 1.75rem 1fr auto auto auto;
    align-items: center;
    gap: 2rem;
    padding: 1.375rem 0;
    border-bottom: 1px solid var(--border);
  }

  .round-row__num {
    font-size: 1.5rem;
    font-weight: 300;
    color: var(--round-accent);
    line-height: 1;
  }

  .round-row__main {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .round-row__label {
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text-dim);
  }

  .round-row__theme {
    font-style: italic;
    color: var(--round-accent);
    font-size: 1.0625rem;
  }

  .round-row__theme-unknown {
    color: var(--text-dim);
    font-size: 1.0625rem;
    font-style: italic;
  }

  .round-row__date {
    font-size: 1rem;
    color: var(--round-accent);
    font-weight: 500;
    white-space: nowrap;
  }

  .round-row__date--unknown {
    color: var(--text-dim);
    font-weight: 400;
  }

  .round-row__info {
    font-size: 0.9375rem;
    color: var(--text-dim);
    white-space: nowrap;
  }

  .round-row__cta {
    text-align: right;
  }

  .round-cta-btn {
    font-size: 0.9375rem;
  }

  .round-badge {
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .round-badge--pending,
  .round-badge--invite {
    color: var(--text-dim);
  }

  .round-badge--closed {
    color: var(--text-muted);
    text-decoration: line-through;
  }

  /* ── CTA BLOCKS ── */
  .event-cta-block {
    padding: 3rem 0;
  }

  .event-cta-block--last {
    padding: 4rem 0 6rem;
  }

  .event-cta-block__inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
  }

  .event-cta-block__tagline {
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    font-style: italic;
    font-weight: 300;
    color: var(--text-muted);
  }

  /* ── DETAILS ── */
  .event-details-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    margin-bottom: 3rem;
  }

  .event-details__text {
    color: var(--text-muted);
    line-height: 1.7;
    font-size: 1rem;
    margin: 0.75rem 0 1rem;
  }

  .event-details__meta {
    font-size: 0.875rem;
    color: var(--text-dim);
    line-height: 1.8;
  }

  .event-prizes {
    display: flex;
    flex-direction: column;
    margin-top: 0.75rem;
  }

  .event-prize {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--border);
  }

.event-prize__place {
    font-size: 1.125rem;
    color: var(--text);
  }

  .event-prize__amount {
    font-size: 1rem;
    color: var(--gold);
    font-weight: 500;
  }

  /* ── RESPONSIVE ── */
  @media (max-width: 768px) {
    .event-details-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .event-structure {
      flex-direction: column;
    }

    .event-structure__box {
      width: 100%;
    }

    .event-structure__arrow {
      transform: rotate(90deg);
    }

    .round-row {
      grid-template-columns: 1.75rem 1fr auto;
      grid-template-rows: auto auto;
    }

    .round-row__info {
      display: none;
    }

    .round-row__cta {
      grid-column: 3;
      grid-row: 1 / 3;
      align-self: center;
    }

    .event-hero__info-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }
</style>
