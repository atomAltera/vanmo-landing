---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Страница не найдена — VANMO"
  description="Такой страницы нет. Вернитесь на главную VANMO — клуб спортивной мафии в Тбилиси."
>
  <section class="notfound">
    <div class="notfound__noise" aria-hidden="true"></div>
    <span class="notfound__ghost font-display" aria-hidden="true">404</span>

    <div class="notfound__inner container mx-auto px-4 sm:px-6 lg:px-8">
      <p class="notfound__eyebrow">Город засыпает…</p>
      <h1 class="notfound__title font-display">
        Эта страница<br />не пережила <em>ночь</em>
      </h1>
      <p class="notfound__text">
        Такого адреса в городе нет — возможно, страницу убрали ещё до рассвета.
        Вернёмся туда, где все свои.
      </p>
      <div class="notfound__actions">
        <a href="/" class="btn-primary">На главную</a>
        <a href="/rules" class="notfound__link">Правила</a>
        <a href="/contacts" class="notfound__link">Контакты</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .notfound {
    position: relative;
    min-height: 80vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: var(--bg);
    padding: 5rem 0;
  }

  /* Dim spotlight so the centre reads and the edges fall into the dark. */
  .notfound::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(
      ellipse 70% 60% at 50% 42%,
      transparent 0%,
      rgba(4, 3, 2, 0.55) 100%
    );
    pointer-events: none;
    z-index: 0;
  }

  :global(:root.day-mode) .notfound::before {
    background: radial-gradient(
      ellipse 70% 60% at 50% 42%,
      transparent 0%,
      rgba(18, 13, 8, 0.12) 100%
    );
  }

  .notfound__noise {
    position: absolute;
    inset: 0;
    opacity: 0.04;
    pointer-events: none;
    z-index: 0;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E");
    background-size: 256px 256px;
  }

  /* The page number as a fading figure behind the message. */
  .notfound__ghost {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -54%);
    font-size: clamp(11rem, 42vw, 30rem);
    font-weight: 300;
    line-height: 1;
    letter-spacing: 0.05em;
    color: var(--text);
    opacity: 0.05;
    white-space: nowrap;
    pointer-events: none;
    z-index: 0;
    user-select: none;
  }

  .notfound__inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.25rem;
    animation: notfound-rise 0.7s ease-out both;
  }

  .notfound__eyebrow {
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--gold);
  }

  .notfound__title {
    font-size: clamp(2rem, 5.5vw, 3.75rem);
    font-weight: 300;
    line-height: 1.05;
    color: var(--text);
    margin: 0;
  }

  .notfound__title em {
    font-style: italic;
    color: var(--accent);
  }

  .notfound__text {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--text-muted);
    max-width: 42ch;
    margin: 0.25rem 0 0.5rem;
  }

  .notfound__actions {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 0.75rem;
  }

  .notfound__link {
    font-size: 0.9375rem;
    color: var(--text-muted);
    text-decoration: underline;
    text-decoration-color: var(--border-md);
    text-underline-offset: 4px;
    transition: color 0.15s;
  }

  .notfound__link:hover {
    color: var(--gold);
  }

  @keyframes notfound-rise {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .notfound__inner {
      animation: none;
    }
  }
</style>
